# Copy to .env in your working demo repository. Never commit .env.
# Use individual HTTPS file links, not folder links or {{wrapped}} values.
# Do not put credentials or access tokens in these values.
# Single or double quotes around a value are optional.
BUSINESS_BRIEF_URL=https://example.invalid/replace-with-business-brief-file-link
DECISION_TRANSCRIPT_URL=https://example.invalid/replace-with-decision-transcript-file-link
COMPLIANCE_NOTE_URL=https://example.invalid/replace-with-compliance-note-file-link
